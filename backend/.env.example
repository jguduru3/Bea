# ---------- Bea backend settings (copy to .env) ----------
POM_ENV=development
POM_LOG_LEVEL=INFO

# Admin key for /admin endpoints (token management, usage). Use a long random string.
POM_ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional: a device token that is created automatically at startup (simplest single-user setup).
# Must start with pom_ . Paste the same value into the Bea app settings.
POM_BOOTSTRAP_DEVICE_TOKEN=pom_replace_with_a_long_random_value

# Let the desktop app save, test and delete the AI and voice keys (Settings > API keys).
# Turn on for a personal server; keep off for a shared company server and use .env instead.
POM_ALLOW_DEVICE_KEY_MANAGEMENT=false

# ---------- Language model ----------
# Main brain: anthropic (Claude) or openai (OpenAI or any OpenAI-compatible endpoint)
POM_LLM_PROVIDER=anthropic
# Backup brain, used automatically if the main one is down, overloaded or out of credit
POM_LLM_FALLBACK_PROVIDER=openai
POM_ANTHROPIC_API_KEY=
POM_ANTHROPIC_MODEL=claude-sonnet-5-5
POM_OPENAI_API_KEY=
POM_OPENAI_MODEL=gpt-4.1-mini
# POM_OPENAI_BASE_URL=https://api.openai.com/v1

POM_ASSISTANT_NAME=Bea
POM_ORGANIZATION_NAME=Better Analytics
# Extra instructions added to Bea's system prompt (company policies, tone, products...)
POM_EXTRA_INSTRUCTIONS=

# ---------- Sarvam AI voice ----------
POM_SARVAM_API_KEY=
POM_SARVAM_TTS_MODEL=bulbul:v3
POM_SARVAM_TTS_SPEAKER=kavya
POM_SARVAM_STT_MODEL=saaras:v4
POM_DEFAULT_LANGUAGE=en-IN

# ---------- Limits ----------
POM_RATE_LIMIT_PER_MINUTE=40
POM_RATE_LIMIT_BURST=15

# ---------- Agent (goals, tools, research, browser, apps). Runs on Claude. ----------
POM_AGENT_ENABLED=true
POM_AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (more effort = more thorough, slower, more tokens)
POM_AGENT_EFFORT=high
POM_AGENT_MAX_STEPS=40
# An approval nobody answers is denied after this many seconds
POM_APPROVAL_TIMEOUT_S=1800
# Bea's browser profiles live here
POM_DATA_DIR=./data
# Let Bea's browser open localhost / intranet addresses (off = safer)
POM_BROWSER_ALLOW_PRIVATE_NETWORKS=false

# ---------- Connected apps (see Bea Hub > Connections for step-by-step setup) ----------
# Microsoft 365: Azure app registration, public client flows on
POM_MICROSOFT_CLIENT_ID=
POM_MICROSOFT_TENANT=common
# Google: OAuth client (Web application) with redirect {POM_PUBLIC_BASE_URL}/v1/connectors/google/callback
POM_GOOGLE_CLIENT_ID=
POM_GOOGLE_CLIENT_SECRET=
POM_PUBLIC_BASE_URL=http://127.0.0.1:8080

# ---------- Secrets saved from the app (API keys, app sign-ins) are encrypted with this ----------
# Leave empty to generate one in POM_SECRET_FILE. Back it up: without it, saved keys can't be read.
POM_KEY_ENCRYPTION_SECRET=
POM_SECRET_FILE=./.pom_secret
